# ── claude-pr-reviewer configuration ───────────────────────────────────────
# Copy to .env and fill in. .env is git-ignored.

# GitHub repo to review, as owner/name (required)
REPO_SLUG=your-org/your-repo

# Local checkout of that repo — the review reads/greps files here (required)
REPO_DIR=~/code/your-repo

# Your GitHub login — the bot skips PRs you authored. Empty = review everything.
OWN_LOGIN=

# Slack channel ID of your PR-review-request channel (required).
# Find it: channel → View details → the C0......  id at the bottom.
SLACK_CHANNEL=C0XXXXXXXXX

# OPTIONAL: Slack bot token (xoxb-...) with the `reactions:write` scope, so the bot
# reacts 👀 / ✅ / 🚫 on the request message. Empty = reactions off.
# See the README "Slack reactions" section for the ~2-minute app setup.
SLACK_BOT_TOKEN=

# Post anything back to Slack after a review? true (default) = react (with a token)
# or a one-line threaded reply (without). false = review silently, GitHub only.
SLACK_NOTIFY=true

# How many recent channel messages to scan each tick.
READ_COUNT=30

# Ignore PRs with number <= this (backlog guard). PR numbers are monotonic, so
# set it to the highest PR number at install time and only newer PRs get reviewed.
# install.sh can set this for you. 0 = review any new PR it sees.
FLOOR=0

# Max reviews launched per tick (new + re-reviews). Bounds cost/blast-radius.
MAX_PER_TICK=5

# Seconds between ticks (used by the fallback loop; systemd/launchd use their own).
INTERVAL_SECS=180

# CLIs. IMPORTANT: systemd/launchd services run with a minimal PATH that usually
# does NOT include ~/.local/bin. If `which claude` / `which gh` shows a path there
# (or anywhere outside /usr/bin), set these to the ABSOLUTE path or the service's
# gh/claude calls silently fail ("author unknown", "gh read failed").
CLAUDE_BIN=claude
GH_BIN=gh

# OPTIONAL: a Claude Code skill to drive the review. Empty = built-in generic
# breaking-change prompt. If you have a review skill, put its name here.
REVIEW_SKILL=

# Web dashboard bind. Keep host on loopback unless you know what you're doing.
WEB_HOST=127.0.0.1
WEB_PORT=8787

# Where runtime state + logs live. Default is fine.
DATA_DIR=~/.local/state/claude-pr-reviewer
