# One file per repo. Copy to instances/<name>.env, fill in, then enable:
#   ./install.sh <name>       # Linux: systemctl --user enable --now pr-reviewer@<name>.timer
# Repo-specific keys live here; shared keys (CLIs, OWN_LOGIN, cadence, web, token)
# come from ../.env. Each instance gets its own isolated state under STATE_ROOT/<name>.

REPO_SLUG=your-org/your-repo
REPO_DIR=~/code/your-repo
SLACK_CHANNEL=C0XXXXXXXXX     # this repo's review-request channel (one channel per repo)
FLOOR=0                        # install.sh <name> --set-floor can set this to the repo's current max PR

# optional per-repo overrides (else inherited from ../.env):
# REVIEW_SKILL=
# SLACK_BOT_TOKEN=
# MAX_PER_TICK=5
# DATA_DIR=~/somewhere/else    # override the default STATE_ROOT/<name>
